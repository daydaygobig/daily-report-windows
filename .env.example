# 应用基础配置
# 后端服务名称，一般不用改
TS_APP_NAME=群聊日报智能助手
# 后端端口，默认 8000
TS_APP_PORT=8000
# 是否开启调试模式，生产使用建议 false
TS_DEBUG=false
# SQLite 数据库路径，默认存到项目 data 目录
TS_DB_PATH=data/app.db

# ChatLog 配置（Windows 版可继续使用 ChatLog；如果使用 WeFlow，可在前端系统设置里切换）
# chatlog 本地 HTTP 服务地址，需要和 chatlog TUI 里启动的 HTTP 地址一致
TS_CHATLOG_BASE_URL=http://127.0.0.1:5030
# 普通拉取聊天记录接口超时时间，单位秒
TS_CHATLOG_TIMEOUT_SEC=60

# chatlog 解密控制
# 是否在拉聊天记录前，先请求 chatlog 执行一次本地解密
TS_CHATLOG_DECRYPT_BEFORE_FETCH=true
# chatlog 解密接口超时时间，单位秒；数据量较大时建议设为 300 秒（5 分钟）
TS_CHATLOG_DECRYPT_TIMEOUT_SEC=300
# 是否启用“解密水位线”缓存：如果查询时间窗口已经被上次解密覆盖，就跳过重复解密
TS_CHATLOG_DECRYPT_CACHE_ENABLED=true
# 解密覆盖判断的缓冲秒数；0 表示只要覆盖到查询结束时间即可跳过，担心边界消息延迟可改为 30 或 60
TS_CHATLOG_DECRYPT_CACHE_BUFFER_SEC=0
# ChatLog 工作目录根路径，用于估算 ChatLog 解密库写入量；只读取文件大小和修改时间
# Windows 示例：C:\Users\你的用户名\Documents\chatlog
TS_CHATLOG_WORK_DIR=C:\Users\你的用户名\Documents\chatlog

# WeFlow HTTP 服务配置（可选，Windows 版也可以使用 WeFlow）
# 前端“系统设置 > 聊天记录接口”里的配置优先级更高；这里仅作为首次初始化默认值
TS_WEFLOW_BASE_URL=http://127.0.0.1:5031
# 可选：WeFlow API Token 兜底值。推荐在前端系统设置里填写，方便小眼睛显示/隐藏和测试
TS_WEFLOW_ACCESS_TOKEN=
# WeFlow 分页拉取消息的每页数量，建议 500-1000
TS_WEFLOW_PAGE_LIMIT=1000
# WeFlow 单页请求超时时间，单位秒；消息量大时建议 180
TS_WEFLOW_PAGE_TIMEOUT_SEC=180
# WeFlow 偶发返回空页时的重试次数
TS_WEFLOW_EMPTY_PAGE_RETRY=2

# 系统时间与文件保存
# 定时任务使用的时区
TS_TIMEZONE=Asia/Shanghai
# 聊天记录、日报、HTML 等本地备份目录
TS_LOCAL_BACKUP_DIR=backups

# 安全配置
# 本地加密用密钥，请在真实 .env 里改成自己的随机字符串，不要提交到公开仓库
TS_SECRETS_KEY=请改成你自己的随机密钥
# 前端允许访问后端的地址；本地开发通常保留这个即可
TS_ALLOWED_ORIGINS=["http://localhost:5173"]

# 案例卡右下角二维码
# 是否在生成的案例卡图片右下角叠加二维码（true/false）
TS_QR_CODE_ENABLED=true
# 二维码指向的链接
TS_QR_CODE_URL=https://md.xinjianhub.cn/
# 二维码下方的小字说明；留空则只贴二维码不带文字
TS_QR_CODE_CAPTION=喜欢您来
# 二维码边长相对画布宽度的比例（0.12 = 画布宽度的 12%）
TS_QR_CODE_SIZE_RATIO=0.12

# ---------------------------------------------------------------------------
# 本地 HTML 案例卡引擎（替代生图模型：文案 -> HTML 排版 -> Edge 截图，零错别字）
# ---------------------------------------------------------------------------
# 开启后 image_card 任务不再调用生图模型，改为本地渲染；上/下卡自动配对成一张完整长卡
TS_HTML_CARD_ENGINE_ENABLED=false
# 卡片产物（card.html / card_data.json / card.png）持久化目录；关系图不准时可手改 card.html 后重渲染
TS_HTML_CARD_OUTPUT_DIR=backups/html_cards
# 页脚二维码指向的链接
TS_HTML_CARD_JOIN_URL=https://md.xinjianhub.cn/#join-us
# 当事人头像素材目录：女性头像命名 F1/F2/...，男性头像命名 M1/M2/...（支持 jpg/png/webp）
TS_HTML_CARD_AVATAR_DIR=image
# Edge/Chrome 可执行文件路径；留空自动探测
TS_HTML_CARD_EDGE_PATH=
# 输出倍率（2 = 2160 宽高清，适合手机阅读）
TS_HTML_CARD_RENDER_SCALE=2
# 人物关系图箭头样式：curve=智能混合（当事人辐射线弧线+卫星连线直线，默认）/ solid=全部实心大三角直线
TS_HTML_CARD_ARROW_STYLE=curve
# 人物关系图引擎（仅本地 HTML 引擎开启时生效）：svg=本地确定性渲染（默认，零错别字）/
# image=用任务上绑定的图片模型绘制整幅关系图；生图或校验失败自动回退 svg，出卡不中断
TS_HTML_CARD_RELATION_ENGINE=svg
# 关系图生图尺寸（RELATION_ENGINE=image 时生效）：1536x1024（横版·推荐）/ 1024x1024
TS_HTML_CARD_RELATION_IMAGE_SIZE=1536x1024
